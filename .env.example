# ══════════════════════════════════════════════════════════════════════════════
# AegiFinance — Variables de entorno
# Copia este archivo como .env y rellena los valores antes de hacer deploy.
#
#   cp .env.example .env
#   docker compose up -d --build
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────────────────────
# Mínimo 8 caracteres, mayúsculas + números + especiales.
MSSQL_SA_PASSWORD=CambiaEsto_Password_Seguro_2026!
# Express es gratuito y apropiado para instalaciones pequeñas (límite de 10 GB).
# Usa una licencia válida como Standard en producción si necesitás más capacidad.
MSSQL_PID=Express

# ── JWT ────────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=CambiaEsto_JWT_Secret_Con_Al_Menos_32_Caracteres_2026

# Contraseña exclusiva para crear el usuario Admin la primera vez.
# Debe cambiarse desde la aplicación después del primer acceso.
ADMIN_SEED_PASSWORD=CambiaEsto_Admin_Inicial_2026!

# Zona horaria IANA usada por el worker para su horario diario.
TZ=America/Mexico_City

# ── Seguridad de acceso ───────────────────────────────────────────────────────
SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_SESSION_LIFETIME_DAYS=7

# ── Red de proxy ──────────────────────────────────────────────────────────────
# Por defecto Compose crea la red. Para reutilizar una red externa de
# Cloudflare/Nginx: PROXY_NETWORK_EXTERNAL=true y define su nombre.
PROXY_NETWORK_NAME=aegifinance-proxy
PROXY_NETWORK_EXTERNAL=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# URL pública del frontend (sin barra al final).
# Debe coincidir con el dominio configurado en Cloudflare Tunnel para el frontend.
CORS_ALLOWED_ORIGINS=https://app.aegifinance.com

# ── Tipo de cambio (opcional) ──────────────────────────────────────────────────
EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest/
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_ENABLED=false

# ── Worker de facturación ──────────────────────────────────────────────────────
# Hora de ejecución diaria (24 h, zona horaria del servidor).
BILLING_DAILY_RUN_TIME=02:00
