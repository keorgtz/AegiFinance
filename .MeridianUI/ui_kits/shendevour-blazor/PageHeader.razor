@* MeridianUI · PageHeader — Encabezado de módulo con título, subtítulo y slot de acciones.
   Equivalente al content-header del shell web.
*@

<div class="meridian-page-header">
    <div class="meridian-page-header-text">
        <h1 class="h-module-title" style="margin: 0;">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <span class="t-body-sm" style="color: var(--gray-muted);">@Subtitle</span>
        }
    </div>
    @if (Actions != null)
    {
        <div class="meridian-page-header-actions">
            @Actions
        </div>
    }
</div>

<style>
    .meridian-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 16px 4px 16px;
        gap: 12px;
    }
    .meridian-page-header-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .meridian-page-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

@code {
    /// <summary>Título del módulo (se muestra en UPPERCASE via CSS h-module-title).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Subtítulo (ej. fecha formateada en es-MX).</summary>
    [Parameter] public string Subtitle { get; set; } = "";

    /// <summary>Slot de acciones (botones, filtros, etc.) alineados a la derecha.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
