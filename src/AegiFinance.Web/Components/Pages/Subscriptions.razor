@page "/subscriptions"
@using AegiFinance.Application.Features.Subscriptions.Queries.GetSubscriptions
@using AegiFinance.Application.Features.Subscriptions.Commands.CreateSubscription
@using AegiFinance.Application.Features.Clients.Queries.GetClients
@using AegiFinance.Application.Features.Services.Queries.GetServices
@using AegiFinance.Domain.Enums
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; }
  .h { padding: 16px 20px; background: var(--in-bg); display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .h-left { display: flex; flex-direction: column; gap: 4px; }
  .h-title { font-size: 11px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 13px; color: var(--in); font-weight: 500; }
  .table-container { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 800px; }
  thead th { background: #fff; padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; position: sticky; top: 0; }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--gray-line); color: var(--gray-700); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { padding: 4px 8px; border-radius: var(--r-sm); font-size: 11px; font-weight: 600; }
  .status-Active { background: var(--em-pl); color: var(--em); }
  .status-Suspended { background: var(--or-pl); color: var(--or); }
  .status-Cancelled { background: #FEE2E2; color: #EF4444; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-secondary { background: var(--gray-line); color: var(--gray-dark); border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; }
  .btn-secondary:hover { background: #D1D5DB; }
  .price { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--in); }
  .date { font-variant-numeric: tabular-nums; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--gray-dark); }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid var(--gray-line); border-radius: var(--r-md); font-size: 14px; outline: none; }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="h-page-title">Suscripciones</div>
    @if (canCreateSubscription)
    {
        <button class="btn-primary" @onclick="OpenCreateModal">
            <span class="material-symbols-rounded" style="font-size: 18px;">add</span> Nueva Suscripción
        </button>
    }
</div>

@if (SubscriptionsList == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">CONTRATOS</span>
                <span class="h-sub">Suscripciones activas e histórico</span>
            </div>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Precio</th>
                        <th>Próximo Cobro</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in SubscriptionsList)
                    {
                        <tr>
                            <td>@sub.Code</td>
                            <td style="font-weight: 600; color: var(--gray-dark);">@sub.ClientName</td>
                            <td>
                                <div>@sub.ServiceName</div>
                                <div style="font-size: 11px; color: var(--gray-muted);">@sub.BillingType</div>
                            </td>
                            <td class="price">@sub.Price.ToString("C") @sub.Currency</td>
                            <td class="date">@(sub.NextBillingDate?.ToString("dd/MMM/yyyy") ?? "-")</td>
                            <td>
                                <span class="status-badge status-@sub.Status">
                                    @sub.Status
                                </span>
                            </td>
                        </tr>
                    }
                    @if (SubscriptionsList.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px; color: var(--gray-muted);">No hay suscripciones registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<Modal IsVisible="@isModalVisible" Title="Nueva Suscripción" OnClose="CloseModal">
    <ChildContent>
        <div class="form-group">
            <label>Cliente</label>
            <select class="form-control" @bind="subscriptionForm.ClientId">
                <option value="">-- Selecciona un Cliente --</option>
                @if (ClientsList != null)
                {
                    @foreach (var c in ClientsList)
                    {
                        <option value="@c.Id">@c.Name (@c.Code)</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Servicio a Contratar</label>
            <select class="form-control" @bind="subscriptionForm.ServiceId">
                <option value="">-- Selecciona un Servicio --</option>
                @if (ServicesList != null)
                {
                    @foreach (var s in ServicesList)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Tipo de Facturación</label>
            <select class="form-control" @bind="subscriptionForm.BillingType">
                <option value="OneTime">Cobro Único</option>
                <option value="Monthly">Mensual</option>
                <option value="Quarterly">Trimestral</option>
                <option value="Semiannual">Semestral</option>
                <option value="Annual">Anual</option>
            </select>
        </div>
        <div class="form-group">
            <label>Precio Acordado (Mensualidad / Total)</label>
            <input type="number" step="0.01" class="form-control" @bind="subscriptionForm.Price" placeholder="0.00" />
        </div>
        <div class="form-group">
            <label>Fecha de Inicio</label>
            <input type="date" class="form-control" @bind="subscriptionForm.StartDate" />
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-secondary" @onclick="CloseModal">Cancelar</button>
        <button class="btn-primary" @onclick="SaveSubscription" disabled="@isSaving">
            @(isSaving ? "Guardando..." : "Guardar")
        </button>
    </FooterContent>
</Modal>

@code {
    private List<SubscriptionListDto>? SubscriptionsList;
    private List<ClientListDto>? ClientsList;
    private List<ServiceListDto>? ServicesList;
    
    private bool canCreateSubscription;

    private bool isModalVisible;
    private bool isSaving;
    private CreateSubscriptionCommand subscriptionForm = new();

    protected override async Task OnInitializedAsync()
    {
        canCreateSubscription = await PermissionService.HasPermissionAsync("CreateSubscription");
        
        // Load all data
        await LoadData();
        
        var clientsResult = await Sender.Send(new GetClientsQuery { PageSize = 100 });
        ClientsList = clientsResult.Items.ToList();
        
        var servicesResult = await Sender.Send(new GetServicesQuery { PageSize = 100 });
        ServicesList = servicesResult.Items.ToList();
    }

    private async Task LoadData()
    {
        var result = await Sender.Send(new GetSubscriptionsQuery { PageSize = 100 });
        SubscriptionsList = result.Items.ToList();
    }

    private void OpenCreateModal()
    {
        subscriptionForm = new CreateSubscriptionCommand
        {
            StartDate = DateTime.Today,
            BillingDay = DateTime.Today.Day,
            AutoRenew = true,
            BillingType = BillingType.Monthly
        };
        isModalVisible = true;
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }

    private async Task SaveSubscription()
    {
        if (subscriptionForm.ClientId == Guid.Empty || subscriptionForm.ServiceId == Guid.Empty) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            await Sender.Send(subscriptionForm);
            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
