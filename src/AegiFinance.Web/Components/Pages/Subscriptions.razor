@page "/subscriptions"
@using AegiFinance.Application.Features.Subscriptions.Queries.GetSubscriptions
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; }
  .h { padding: 16px 20px; background: var(--in-bg); display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .h-left { display: flex; flex-direction: column; gap: 4px; }
  .h-title { font-size: 11px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 13px; color: var(--in); font-weight: 500; }
  .table-container { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 800px; }
  thead th { background: #fff; padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; position: sticky; top: 0; }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--gray-line); color: var(--gray-700); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { padding: 4px 8px; border-radius: var(--r-sm); font-size: 11px; font-weight: 600; }
  .status-Active { background: var(--em-pl); color: var(--em); }
  .status-Suspended { background: var(--or-pl); color: var(--or); }
  .status-Cancelled { background: #FEE2E2; color: #EF4444; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--primary-dark); }
  .price { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--in); }
  .date { font-variant-numeric: tabular-nums; }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="h-page-title">Suscripciones</div>
    @if (canCreateSubscription)
    {
        <button class="btn-primary">
            <span class="material-symbols-rounded" style="font-size: 18px;">add</span> Nueva Suscripción
        </button>
    }
</div>

@if (SubscriptionsList == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">CONTRATOS</span>
                <span class="h-sub">Suscripciones activas e histórico</span>
            </div>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Precio</th>
                        <th>Próximo Cobro</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in SubscriptionsList)
                    {
                        <tr>
                            <td>@sub.Code</td>
                            <td style="font-weight: 600; color: var(--gray-dark);">@sub.ClientName</td>
                            <td>
                                <div>@sub.ServiceName</div>
                                <div style="font-size: 11px; color: var(--gray-muted);">@sub.BillingType</div>
                            </td>
                            <td class="price">@sub.Price.ToString("C") @sub.Currency</td>
                            <td class="date">@(sub.NextBillingDate?.ToString("dd/MMM/yyyy") ?? "-")</td>
                            <td>
                                <span class="status-badge status-@sub.Status">
                                    @sub.Status
                                </span>
                            </td>
                        </tr>
                    }
                    @if (SubscriptionsList.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px; color: var(--gray-muted);">No hay suscripciones registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<SubscriptionListDto>? SubscriptionsList;
    private bool canCreateSubscription;

    protected override async Task OnInitializedAsync()
    {
        canCreateSubscription = await PermissionService.HasPermissionAsync("CreateSubscription");
        var result = await Sender.Send(new GetSubscriptionsQuery { PageSize = 100 });
        SubscriptionsList = result.Items.ToList();
    }
}
