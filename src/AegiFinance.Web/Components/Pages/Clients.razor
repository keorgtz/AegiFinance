@page "/clients"
@using AegiFinance.Application.Features.Clients.Queries.GetClients
@using AegiFinance.Application.Features.Clients.Commands.CreateClient
@using AegiFinance.Application.Features.Clients.Commands.UpdateClient
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; }
  .h { padding: 16px 20px; background: var(--in-bg); display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .h-left { display: flex; flex-direction: column; gap: 4px; }
  .h-title { font-size: 11px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 13px; color: var(--in); font-weight: 500; }
  .table-container { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 600px; }
  thead th { background: #fff; padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; position: sticky; top: 0; }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--gray-line); color: var(--gray-700); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { background: var(--in-pl); color: var(--in); padding: 4px 8px; border-radius: var(--r-sm); font-size: 11px; font-weight: 600; }
  .status-active { background: var(--em-pl); color: var(--em); }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-secondary { background: var(--gray-line); color: var(--gray-dark); border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; }
  .btn-secondary:hover { background: #D1D5DB; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--gray-dark); }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid var(--gray-line); border-radius: var(--r-md); font-size: 14px; outline: none; }
  .btn-icon { background: none; border: none; padding: 4px; cursor: pointer; color: var(--gray-muted); border-radius: var(--r-sm); }
  .btn-icon:hover { background: #F3F4F6; color: var(--primary); }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="h-page-title">Clientes</div>
    @if (canCreateClient)
    {
        <button class="btn-primary" @onclick="OpenCreateModal">
            <span class="material-symbols-rounded" style="font-size: 18px;">add</span> Nuevo Cliente
        </button>
    }
</div>

@if (ClientsList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">DIRECTORIO</span>
                <span class="h-sub">Clientes registrados</span>
            </div>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Nombre Comercial</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in ClientsList)
                    {
                        <tr>
                            <td>@client.Code</td>
                            <td style="font-weight: 500; color: var(--gray-dark);">@client.Name</td>
                            <td>@client.TradeName</td>
                            <td>
                                <span class="status-badge @(client.Status == "Active" ? "status-active" : "")">
                                    @client.Status
                                </span>
                            </td>
                            <td style="display: flex; gap: 8px; align-items: center;">
                                <button class="btn-icon" @onclick="() => OpenEditModal(client)" title="Editar">
                                    <span class="material-symbols-rounded" style="font-size: 18px;">edit</span>
                                </button>
                                <a href="/clients/@client.Id/statement" class="btn-icon" style="text-decoration: none;" title="Ver Edo. Cuenta">
                                    <span class="material-symbols-rounded" style="font-size: 18px; color: var(--primary);">receipt_long</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (ClientsList.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 32px; color: var(--gray-muted);">No hay clientes registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<Modal IsVisible="@isModalVisible" Title="@(isEditing ? "Editar Cliente" : "Nuevo Cliente")" OnClose="CloseModal">
    <ChildContent>
        <div class="form-group">
            <label>Nombre Fiscal (Name)</label>
            <input class="form-control" @bind="clientForm.Name" placeholder="Razón Social" />
        </div>
        <div class="form-group">
            <label>Nombre Comercial (Trade Name)</label>
            <input class="form-control" @bind="clientForm.TradeName" placeholder="Nombre visible" />
        </div>
        <div class="form-group">
            <label>Tax ID (RFC)</label>
            <input class="form-control" @bind="clientForm.TaxId" placeholder="RFC" />
        </div>
        <div class="form-group">
            <label>Email de Facturación</label>
            <input class="form-control" type="email" @bind="clientForm.BillingEmail" placeholder="contacto@empresa.com" />
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-secondary" @onclick="CloseModal">Cancelar</button>
        <button class="btn-primary" @onclick="SaveClient" disabled="@isSaving">
            @(isSaving ? "Guardando..." : "Guardar")
        </button>
    </FooterContent>
</Modal>

@code {
    private List<ClientListDto>? ClientsList;
    private bool canCreateClient;
    
    // Modal state
    private bool isModalVisible;
    private bool isEditing;
    private bool isSaving;
    private UpdateClientCommand clientForm = new();

    protected override async Task OnInitializedAsync()
    {
        canCreateClient = await PermissionService.HasPermissionAsync("CreateClient");
        await LoadClients();
    }

    private async Task LoadClients()
    {
        var result = await Sender.Send(new GetClientsQuery { PageSize = 100 });
        ClientsList = result.Items.ToList();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        clientForm = new UpdateClientCommand();
        isModalVisible = true;
    }

    private void OpenEditModal(ClientListDto client)
    {
        isEditing = true;
        clientForm = new UpdateClientCommand
        {
            Id = client.Id,
            Name = client.Name,
            TradeName = client.TradeName,
            // (Mock map, we might need a GetClientById query for full details but for now we map what we have)
            // or let the update command ignore nulls if we don't have them.
        };
        isModalVisible = true;
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(clientForm.Name)) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            if (isEditing)
            {
                await Sender.Send(clientForm);
            }
            else
            {
                var createCommand = new CreateClientCommand
                {
                    Name = clientForm.Name,
                    TradeName = clientForm.TradeName,
                    TaxId = clientForm.TaxId,
                    BillingEmail = clientForm.BillingEmail
                };
                await Sender.Send(createCommand);
            }

            await LoadClients();
            CloseModal();
        }
        catch (Exception ex)
        {
            // Handle error (show a toast or error message in modal)
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
