@page "/clients"
@using AegiFinance.Application.Features.Clients.Queries.GetClients
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; width: 100%; margin-bottom: 20px; }
  .h { padding: 12px 16px; background: #EEF2FF; display: flex; align-items: center; justify-content: space-between; }
  .h-left { display: flex; flex-direction: column; gap: 2px; }
  .h-title { font-size: 10.5px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 12px; color: #6366F1; font-weight: 500; }
  table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  thead th { background: #fff; padding: 7px 12px; text-align: left; font-size: 10.5px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; }
  tbody td { padding: 6px 12px; border-bottom: .5px solid var(--gray-line); color: #374151; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { background: #EEF2FF; color: #6366F1; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  .status-active { background: #ECFDF5; color: #059669; }
</style>

<div class="h-page-title" style="margin-bottom: 24px;">Clientes</div>

@if (ClientsList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">DIRECTORIO</span>
                <span class="h-sub">Clientes registrados</span>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Nombre Comercial</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in ClientsList)
                {
                    <tr>
                        <td>@client.Code</td>
                        <td style="font-weight: 500;">@client.Name</td>
                        <td>@client.TradeName</td>
                        <td>
                            <span class="status-badge @(client.Status == "Active" ? "status-active" : "")">
                                @client.Status
                            </span>
                        </td>
                        <td>
                            <a href="/clients/@client.Id/statement" style="color: var(--primary); text-decoration: none; font-size: 12px; font-weight: 500;">Ver Edo. Cuenta</a>
                        </td>
                    </tr>
                }
                @if (ClientsList.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 20px; color: var(--gray-muted);">No hay clientes registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClientListDto>? ClientsList;

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetClientsQuery { PageSize = 100 });
        ClientsList = result.Items.ToList();
    }
}
