@page "/services"
@using AegiFinance.Application.Features.Services.Queries.GetServices
@using AegiFinance.Application.Features.Services.Commands.CreateService
@using AegiFinance.Application.Features.Services.Commands.UpdateService
@using AegiFinance.Domain.Enums
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; }
  .h { padding: 16px 20px; background: var(--in-bg); display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .h-left { display: flex; flex-direction: column; gap: 4px; }
  .h-title { font-size: 11px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 13px; color: var(--in); font-weight: 500; }
  .table-container { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 600px; }
  thead th { background: #fff; padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; position: sticky; top: 0; }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--gray-line); color: var(--gray-700); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { background: var(--in-pl); color: var(--in); padding: 4px 8px; border-radius: var(--r-sm); font-size: 11px; font-weight: 600; }
  .status-active { background: var(--em-pl); color: var(--em); }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-secondary { background: var(--gray-line); color: var(--gray-dark); border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; }
  .btn-secondary:hover { background: #D1D5DB; }
  .price { font-weight: 600; font-variant-numeric: tabular-nums; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--gray-dark); }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid var(--gray-line); border-radius: var(--r-md); font-size: 14px; outline: none; }
  .btn-icon { background: none; border: none; padding: 4px; cursor: pointer; color: var(--gray-muted); border-radius: var(--r-sm); }
  .btn-icon:hover { background: #F3F4F6; color: var(--primary); }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="h-page-title">Catálogo de Servicios</div>
    @if (canCreateService)
    {
        <button class="btn-primary" @onclick="OpenCreateModal">
            <span class="material-symbols-rounded" style="font-size: 18px;">add</span> Nuevo Servicio
        </button>
    }
</div>

@if (ServicesList == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">SERVICIOS</span>
                <span class="h-sub">Servicios y planes disponibles</span>
            </div>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Facturación</th>
                        <th>Precio Base</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var srv in ServicesList)
                    {
                        <tr>
                            <td>@srv.Code</td>
                            <td style="font-weight: 500; color: var(--gray-dark);">@srv.Name</td>
                            <td>@(string.IsNullOrEmpty(srv.CategoryName) ? "Sin categoría" : srv.CategoryName)</td>
                            <td>@srv.BillingType</td>
                            <td class="price" style="color: var(--em);">@srv.DefaultPrice.ToString("C") @srv.Currency</td>
                            <td>
                                <span class="status-badge @(srv.IsActive ? "status-active" : "")">
                                    @(srv.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <button class="btn-icon" @onclick="() => OpenEditModal(srv)" title="Editar">
                                    <span class="material-symbols-rounded" style="font-size: 18px;">edit</span>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (ServicesList.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px; color: var(--gray-muted);">No hay servicios registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<Modal IsVisible="@isModalVisible" Title="@(isEditing ? "Editar Servicio" : "Nuevo Servicio")" OnClose="CloseModal">
    <ChildContent>
        <div class="form-group">
            <label>Nombre del Servicio / Producto</label>
            <input class="form-control" @bind="serviceForm.Name" placeholder="Ej. Suscripción Mensual Básica" />
        </div>
        <div class="form-group">
            <label>Tipo de Facturación</label>
            <select class="form-control" @bind="serviceForm.BillingType">
                <option value="OneTime">Cobro Único</option>
                <option value="Monthly">Mensual</option>
                <option value="Quarterly">Trimestral</option>
                <option value="Semiannual">Semestral</option>
                <option value="Annual">Anual</option>
            </select>
        </div>
        <div class="form-group">
            <label>Precio Base</label>
            <input type="number" step="0.01" class="form-control" @bind="serviceForm.DefaultPrice" placeholder="0.00" />
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-secondary" @onclick="CloseModal">Cancelar</button>
        <button class="btn-primary" @onclick="SaveService" disabled="@isSaving">
            @(isSaving ? "Guardando..." : "Guardar")
        </button>
    </FooterContent>
</Modal>

@code {
    private List<ServiceListDto>? ServicesList;
    private bool canCreateService;

    // Modal state
    private bool isModalVisible;
    private bool isEditing;
    private bool isSaving;
    private UpdateServiceCommand serviceForm = new();

    protected override async Task OnInitializedAsync()
    {
        canCreateService = await PermissionService.HasPermissionAsync("CreateService");
        await LoadServices();
    }

    private async Task LoadServices()
    {
        var result = await Sender.Send(new GetServicesQuery { PageSize = 100 });
        ServicesList = result.Items.ToList();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        serviceForm = new UpdateServiceCommand { BillingType = BillingType.Monthly };
        isModalVisible = true;
    }

    private void OpenEditModal(ServiceListDto srv)
    {
        isEditing = true;
        // Map as best as possible from Dto
        serviceForm = new UpdateServiceCommand
        {
            Id = srv.Id,
            Name = srv.Name,
            DefaultPrice = srv.DefaultPrice,
            // BillingType is string in Dto, parse to enum
            BillingType = Enum.TryParse<BillingType>(srv.BillingType, out var parsed) ? parsed : BillingType.Monthly
        };
        isModalVisible = true;
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }

    private async Task SaveService()
    {
        if (string.IsNullOrWhiteSpace(serviceForm.Name)) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            if (isEditing)
            {
                await Sender.Send(serviceForm);
            }
            else
            {
                var createCmd = new CreateServiceCommand
                {
                    Name = serviceForm.Name,
                    BillingType = serviceForm.BillingType,
                    DefaultPrice = serviceForm.DefaultPrice
                };
                await Sender.Send(createCmd);
            }

            await LoadServices();
            CloseModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
