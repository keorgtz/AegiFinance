@page "/bank-reconciliation"
@using AegiFinance.Application.Features.BankReconciliation.Commands
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ISender Sender
@inject NavigationManager Nav

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; padding: 24px; }
  .h-page-title { font-size: 20px; font-weight: 600; color: var(--gray-dark); margin-bottom: 16px; }
  .drop-zone { border: 2px dashed var(--primary); border-radius: var(--r-md); padding: 40px; text-align: center; cursor: pointer; transition: all 0.2s; background: var(--primary-light); color: var(--primary-dark); }
  .drop-zone:hover { background: #E0E7FF; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 16px; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--gray-dark); }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid var(--gray-line); border-radius: var(--r-md); font-size: 14px; outline: none; }
</style>

<div class="h-page-title">Conciliación Bancaria</div>

<div class="card">
    <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Importar Estado de Cuenta (CSV)</h3>
    
    <div class="form-group" style="max-width: 400px;">
        <label>Cuenta Bancaria (ID - Mock para MVP)</label>
        <input type="text" class="form-control" @bind="bankAccountIdInput" placeholder="Guid de la cuenta bancaria" />
    </div>

    <div class="drop-zone" onclick="document.getElementById('fileInput').click()">
        <span class="material-symbols-rounded" style="font-size: 48px; margin-bottom: 8px;">upload_file</span>
        <div style="font-weight: 500; font-size: 16px;">Sube tu archivo CSV</div>
        <div style="font-size: 13px; opacity: 0.8; margin-top: 4px;">Formato esperado: Date, Description, Reference, Amount</div>
    </div>
    
    <InputFile id="fileInput" OnChange="HandleFileSelected" style="display: none;" accept=".csv" />

    @if (selectedFile != null)
    {
        <div style="margin-top: 16px; padding: 12px; background: #F3F4F6; border-radius: var(--r-md); display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-rounded" style="color: var(--gray-muted);">description</span>
                <span style="font-size: 14px; font-weight: 500;">@selectedFile.Name</span>
            </div>
            <button class="btn-primary" @onclick="UploadFile" disabled="@isUploading">
                @(isUploading ? "Importando..." : "Importar Datos")
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="margin-top: 16px; padding: 12px; background: #FEE2E2; color: #EF4444; border-radius: var(--r-md); font-size: 14px;">
            @errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div style="margin-top: 16px; padding: 12px; background: #D1FAE5; color: #10B981; border-radius: var(--r-md); font-size: 14px;">
            @successMessage
        </div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private string? successMessage;
    private bool isUploading;
    private string bankAccountIdInput = "00000000-0000-0000-0000-000000000000"; // Mock default

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        successMessage = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        if (!Guid.TryParse(bankAccountIdInput, out Guid accountId))
        {
            errorMessage = "ID de cuenta bancaria inválido.";
            return;
        }

        isUploading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB max
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var command = new UploadStatementCommand
            {
                BankAccountId = accountId,
                FileName = selectedFile.Name,
                FileStream = memoryStream
            };

            var statementId = await Sender.Send(command);
            
            successMessage = $"¡Archivo importado con éxito! Se han registrado los movimientos en el Ledger.";
            selectedFile = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al importar: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }
}
