@page "/billing"
@using AegiFinance.Application.Features.Billing.Queries.GetBillingItems
@using AegiFinance.Application.Dtos
@using MediatR
@inject ISender Sender

<style>
  .card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow); width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; }
  .h { padding: 16px 20px; background: var(--in-bg); display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .h-left { display: flex; flex-direction: column; gap: 4px; }
  .h-title { font-size: 11px; font-weight: 600; color: var(--gray-muted); text-transform: uppercase; letter-spacing: .06em; }
  .h-sub { font-size: 13px; color: var(--in); font-weight: 500; }
  .table-container { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 800px; }
  thead th { background: #fff; padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-muted); border-bottom: 1px solid var(--gray-line); text-transform: uppercase; letter-spacing: .05em; position: sticky; top: 0; }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--gray-line); color: var(--gray-700); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFAFA; cursor: pointer; }
  .status-badge { padding: 4px 8px; border-radius: var(--r-sm); font-size: 11px; font-weight: 600; }
  .status-Pending { background: var(--am-pl); color: var(--am); }
  .status-Paid { background: var(--em-pl); color: var(--em); }
  .status-Partial { background: var(--in-pl); color: var(--in); }
  .status-Voided { background: #FEE2E2; color: #EF4444; }
  .price { font-weight: 600; font-variant-numeric: tabular-nums; }
  .date { font-variant-numeric: tabular-nums; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: var(--r-md); font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--primary-dark); }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="h-page-title">Cargos Mensuales</div>
    @if (canGenerateBilling)
    {
        <button class="btn-primary">
            <span class="material-symbols-rounded" style="font-size: 18px;">play_arrow</span> Generar Cargos
        </button>
    }
</div>

@if (BillingItemsList == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card">
        <div class="h">
            <div class="h-left">
                <span class="h-title">FACTURACIÓN</span>
                <span class="h-sub">Cargos y recibos generados</span>
            </div>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Cliente</th>
                        <th>Suscripción</th>
                        <th>Vencimiento</th>
                        <th>Monto</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in BillingItemsList)
                    {
                        <tr>
                            <td style="font-weight: 500; color: var(--gray-dark);">@item.Description</td>
                            <td>@item.ClientName</td>
                            <td style="color: var(--gray-muted);">@item.SubscriptionCode</td>
                            <td class="date">@item.DueDate.ToString("dd/MMM/yyyy")</td>
                            <td class="price">@item.Amount.ToString("C") @item.Currency</td>
                            <td class="price" style="color: var(--or);">@item.Balance.ToString("C")</td>
                            <td>
                                <span class="status-badge status-@item.Status">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                    @if (BillingItemsList.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 32px; color: var(--gray-muted);">No hay cargos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BillingItemListDto>? BillingItemsList;
    private bool canGenerateBilling;

    protected override async Task OnInitializedAsync()
    {
        canGenerateBilling = await PermissionService.HasPermissionAsync("GenerateBilling");
        var result = await Sender.Send(new GetBillingItemsQuery { PageSize = 100 });
        BillingItemsList = result.Items.ToList();
    }
}
