@using AegiFinance.Web.Services
@inject IPermissionService PermissionService

<style>
  .nav-group { font-size: 9px; font-weight: 700; letter-spacing: .12em; color: var(--gray-muted); text-transform: uppercase; padding: 12px 16px 4px; }
  .sep { height: 1px; background: var(--gray-line); margin: 4px 0; }
  .items-wrap { padding: 8px 0; }
  .item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; margin: 1px 8px; border-radius: 10px; cursor: pointer; transition: background .12s; text-decoration: none; }
  .item:hover { background: #F0F4FF; }
  .item:hover .mi, .item:hover .name { color: #6366F1; }
  .item.active { background: #EEF2FF; box-shadow: 0 1px 3px rgba(99,102,241,.12); }
  .item .mi { font-family: 'Material Symbols Rounded'; font-size: 18px; color: var(--gray-muted); }
  .item.active .mi { color: #6366F1; }
  .item .name { font-size: 13px; font-weight: 500; color: var(--gray-muted); }
  .item.active .name { color: #6366F1; font-weight: 600; }
</style>

<div class="items-wrap">
    <NavLink class="item" href="" Match="NavLinkMatch.All">
        <span class="mi">dashboard</span><span class="name">Dashboard</span>
    </NavLink>
    
    <div class="sep"></div>
    <div class="nav-group">Directorio</div>
    
    @if (canViewClients)
    {
        <NavLink class="item" href="clients">
            <span class="mi">group</span><span class="name">Clientes</span>
        </NavLink>
    }
    
    @if (canViewServices)
    {
        <NavLink class="item" href="services">
            <span class="mi">category</span><span class="name">Servicios</span>
        </NavLink>
    }
    
    <div class="sep"></div>
    <div class="nav-group">Operación</div>
    
    @if (canViewSubscriptions)
    {
        <NavLink class="item" href="subscriptions">
            <span class="mi">assignment</span><span class="name">Suscripciones</span>
        </NavLink>
    }
    
    @if (canViewBilling)
    {
        <NavLink class="item" href="billing">
            <span class="mi">receipt</span><span class="name">Cargos Mensuales</span>
        </NavLink>
    }
    
    <div class="sep"></div>
    <div class="nav-group">Finanzas</div>
    
    @if (canViewLedger)
    {
        <NavLink class="item" href="ledger">
            <span class="mi">account_balance_wallet</span><span class="name">Libro Mayor</span>
        </NavLink>
    }
    
    @if (canViewAllocations)
    {
        <NavLink class="item" href="allocations">
            <span class="mi">fact_check</span><span class="name">Conciliación</span>
        </NavLink>
    }
    
    @if (canViewAccountStatements)
    {
        <NavLink class="item" href="statements">
            <span class="mi">receipt_long</span><span class="name">Estados de Cuenta</span>
        </NavLink>
    }
</div>

@code {
    private bool canViewClients;
    private bool canViewServices;
    private bool canViewSubscriptions;
    private bool canViewBilling;
    private bool canViewLedger;
    private bool canViewAllocations;
    private bool canViewAccountStatements;

    protected override async Task OnInitializedAsync()
    {
        // Implementación SVA (Single View Architecture)
        // Consultamos al PermissionService para decidir si el usuario puede ver la ruta.
        canViewClients = await PermissionService.HasPermissionAsync("ViewClients");
        canViewServices = await PermissionService.HasPermissionAsync("ViewServices");
        canViewSubscriptions = await PermissionService.HasPermissionAsync("ViewSubscriptions");
        canViewBilling = await PermissionService.HasPermissionAsync("ViewBilling");
        canViewLedger = await PermissionService.HasPermissionAsync("ViewLedger");
        canViewAllocations = await PermissionService.HasPermissionAsync("ViewAllocations");
        canViewAccountStatements = await PermissionService.HasPermissionAsync("ViewAccountStatements");
    }
}
