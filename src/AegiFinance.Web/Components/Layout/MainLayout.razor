@inherits LayoutComponentBase

<style>
  .shell-container { display: flex; flex-direction: column; height: 100vh; background: var(--page-bg); font-family: var(--font); color: var(--gray-dark); }
  .titlebar { background: #fff; display: flex; align-items: center; justify-content: space-between; height: 48px; border-bottom: 1px solid var(--gray-line); box-shadow: var(--shadow); flex-shrink: 0; }
  .tb-left { display: flex; align-items: center; height: 100%; }
  .tb-logo { width: 220px; height: 100%; display: flex; align-items: center; gap: 10px; padding: 0 16px; border-right: 1px solid var(--gray-line); }
  .tb-logo-name { font-family: var(--font-brand); font-size: 16px; font-weight: 700; color: var(--gray-dark); letter-spacing: -.005em; }
  .tb-logo-name span { color: var(--primary); font-weight: 700; }
  .crumb { display: flex; align-items: center; gap: 8px; padding-left: 20px; font-size: 13px; color: var(--gray-muted); }
  .crumb .current { color: var(--gray-dark); font-weight: 500; }
  .tb-right { display: flex; align-items: center; gap: 10px; padding-right: 16px; }
  .av { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, #8B5CF6, #6366F1); color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

  .mid { height: 54px; background: #fff; border-bottom: 1px solid var(--gray-line); padding: 0 20px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
  .mid-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; }

  .shell-body { display: flex; flex: 1; min-height: 0; }
  .shell-sidebar { width: 240px; background: #fff; border-right: 1px solid var(--gray-line); display: flex; flex-direction: column; flex-shrink: 0; }
  .shell-content { flex: 1; overflow-y: auto; padding: 20px; }

  .statusbar { height: 28px; background: #fff; border-top: 1px solid var(--gray-line); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; font-size: 11px; color: var(--gray-muted); flex-shrink: 0; }
  .sb-l, .sb-r { display: flex; align-items: center; gap: 0; }
  .sb-i { display: flex; align-items: center; gap: 5px; padding: 0 10px; border-right: 1px solid var(--gray-line); }
  .sb-i:first-child { padding-left: 0; }
  .sb-r .sb-i { border-right: none; border-left: 1px solid var(--gray-line); }
  .sb-i:last-child { border: none; }
  .sb-dot { width: 6px; height: 6px; border-radius: 50%; background: #10B981; }

  /* Blazor Error UI */
  #blazor-error-ui {
    background: lightyellow;
    bottom: 0;
    box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
    display: none;
    left: 0;
    padding: 0.6rem 1.25rem 0.7rem 1.25rem;
    position: fixed;
    width: 100%;
    z-index: 1000;
  }
  #blazor-error-ui .dismiss {
    cursor: pointer;
    position: absolute;
    right: 0.75rem;
    top: 0.5rem;
  }
  
  .menu-toggle { display: none; background: transparent; border: none; font-family: 'Material Symbols Rounded'; font-size: 24px; color: var(--gray-muted); cursor: pointer; padding: 4px; }
  
  @@media (max-width: 768px) {
    .tb-logo { width: auto; border: none; }
    .crumb { display: none; }
    .menu-toggle { display: block; }
    .shell-sidebar { position: fixed; top: 102px; bottom: 28px; left: -240px; z-index: 100; transition: left 0.3s ease; box-shadow: var(--shadow-3); }
    .shell-sidebar.open { left: 0; }
  }
</style>

<div class="shell-container">
    <div class="titlebar">
        <div class="tb-left">
            <button class="menu-toggle" @onclick="ToggleSidebar">menu</button>
            <div class="tb-logo"><div class="tb-logo-name">Aegi<span>Finance</span></div></div>
            <div class="crumb"><span>AegiFinance</span><span style="opacity:.5">›</span><span class="current">App</span></div>
        </div>
        <div class="tb-right">
            <span class="av">AF</span>
        </div>
    </div>
    
    <div class="mid">
        <div>
            <span class="mid-title">AegiFinance</span>
        </div>
    </div>

    <div class="shell-body">
        <div class="shell-sidebar @(isSidebarOpen ? "open" : "")">
            <NavMenu />
        </div>
        <article class="shell-content">
            @Body
        </article>
    </div>

    <div class="statusbar">
        <div class="sb-l"><div class="sb-i"><span class="sb-dot"></span>Online</div></div>
        <div class="sb-r"><div class="sb-i">AegiFinance v1.0</div></div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}
